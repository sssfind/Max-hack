# Скопируйте файл в .env и замените все replace_me_*.
# Никогда не коммитьте .env.

POSTGRES_USER=skillgap
POSTGRES_PASSWORD=replace_me_with_a_long_url_safe_random_password
POSTGRES_DB=skillgap

# Кабинет MAX: «Чат-боты» -> настройки бота.
MAX_BOT_TOKEN=replace_me_with_max_bot_token

# 5–256 символов: A-Z a-z 0-9 _ -
MAX_WEBHOOK_SECRET=replace_me_with_random_webhook_secret
MAX_WEBHOOK_MAX_BODY_BYTES=1048576

# Production: публичный HTTPS URL на порту 443,
# например https://bot.example.com/webhook. Пустое значение отключает автоподписку.
MAX_WEBHOOK_URL=
MAX_WEBHOOK_RECONCILE_INTERVAL=30m

SKILLGAP_CATALOG_PATH=/app/spo_program_vacancy_map.json
# Безопасный production default: только актуальные проверенные программы.
# current — все актуальные; all — все 610 кодов с предупреждением для непроверенных моделей.
SKILLGAP_CATALOG_POLICY=pilot

# «Работа России»
TRUDVSEM_BASE_URL=https://opendata.trudvsem.ru/api/v1/vacancies
TRUDVSEM_REQUEST_TIMEOUT=25s
TRUDVSEM_MAX_RESPONSE_BYTES=8388608
TRUDVSEM_REQUESTS_PER_SECOND=3
TRUDVSEM_MAX_PAGES_PER_QUERY=2

# Анализ и PDF
SKILLGAP_ANALYSIS_TIMEOUT=90s
SKILLGAP_MAX_QUERIES=6
SKILLGAP_QUERY_CONCURRENCY=3
SKILLGAP_PER_QUERY_LIMIT=100
SKILLGAP_MAX_VACANCIES=50
SKILLGAP_VACANCY_CACHE_MAX_BYTES=33554432
SKILLGAP_PDF_MAX_VACANCIES=15
SKILLGAP_ANALYSIS_WORKERS=4
SKILLGAP_ANALYSIS_QUEUE=100
SKILLGAP_SESSION_TTL=24h

# Разбор федеральной ПОП/ФГОС для Skill Gap
SKILLGAP_DOCUMENT_TIMEOUT=20s
SKILLGAP_PDF_PARSE_TIMEOUT=15s
SKILLGAP_PDF_MAX_MEMORY_BYTES=536870912
SKILLGAP_DOCUMENT_CACHE_TTL=30m
SKILLGAP_DOCUMENT_CACHE_MAX_BYTES=33554432
SKILLGAP_DOCUMENT_MAX_BYTES=20971520
SKILLGAP_DOCUMENT_MAX_PAGES=300
SKILLGAP_DOCUMENT_MAX_SKILLS=100

# Надёжная очередь webhook и сроки хранения технических событий
SKILLGAP_EVENT_WORKERS=20
SKILLGAP_EVENT_QUEUE=10000
SKILLGAP_EVENT_HANDLER_TIMEOUT=30s
SKILLGAP_EVENT_MAX_ATTEMPTS=8
SKILLGAP_EVENT_PROCESSING_TIMEOUT=2m
SKILLGAP_EVENT_RECOVERY_INTERVAL=2s
SKILLGAP_EVENT_RECOVERY_BATCH=500
SKILLGAP_EVENT_CLEANUP_INTERVAL=6h
SKILLGAP_EVENT_COMPLETED_TTL=720h
SKILLGAP_EVENT_FAILED_TTL=168h

# Нужен только при включённом профиле observability.
GRAFANA_PASSWORD=replace_me_with_a_long_random_grafana_password
# В production задайте observability, если профиль должен переживать deploy.
COMPOSE_PROFILES=

# Локальный тег образа. CI/CD переопределяет его commit SHA.
SKILLGAP_IMAGE_TAG=local
