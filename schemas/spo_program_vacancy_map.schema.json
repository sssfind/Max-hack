{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://skillgap.local/schemas/spo_program_vacancy_map.schema.json",
  "title": "SkillGap SPO program to vacancy-query catalog",
  "type": "object",
  "required": ["metadata", "programs"],
  "properties": {
    "_documentation": { "type": "object" },
    "metadata": {
      "type": "object",
      "required": [
        "schema_version", "generated_on", "source_name", "source_url", "source_rows",
        "unique_program_codes", "current_program_codes", "programs_requiring_query_review", "coverage"
      ],
      "properties": {
        "schema_version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
        "generated_on": { "type": "string", "format": "date" },
        "source_name": { "type": "string", "minLength": 1 },
        "source_url": { "type": "string", "format": "uri", "pattern": "^https://" },
        "source_rows": { "type": "integer", "minimum": 0 },
        "unique_program_codes": { "type": "integer", "minimum": 1 },
        "current_program_codes": { "type": "integer", "minimum": 0 },
        "programs_requiring_query_review": { "type": "integer", "minimum": 0 },
        "coverage": { "type": "string" }
      },
      "additionalProperties": false
    },
    "programs": {
      "type": "object",
      "minProperties": 1,
      "patternProperties": {
        "^[0-9]{2}\\.[0-9]{2}\\.[0-9]{2}$": { "$ref": "#/$defs/program" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "$defs": {
    "nullableString": { "type": ["string", "null"] },
    "nullableHTTPSURL": {
      "anyOf": [
        { "type": "null" },
        { "type": "string", "format": "uri", "pattern": "^https://" }
      ]
    },
    "standard": {
      "type": "object",
      "required": ["fgos_status", "fgos_url", "pop_status", "pop_url", "admission_ends"],
      "properties": {
        "fgos_requisites": { "$ref": "#/$defs/nullableString" },
        "fgos_year": { "type": ["integer", "null"], "minimum": 1900, "maximum": 2200 },
        "fgos_status": { "enum": ["принят", "!!! проект в разработке", "утратил силу"] },
        "fgos_url": { "$ref": "#/$defs/nullableHTTPSURL" },
        "pop_status": { "enum": [null, "утвержден", "проект"] },
        "pop_url": { "$ref": "#/$defs/nullableHTTPSURL" },
        "admission_ends": { "$ref": "#/$defs/nullableString" },
        "admission_end_year": { "type": ["integer", "null"], "minimum": 1900, "maximum": 2200 },
        "duration_after_grade_9": { "$ref": "#/$defs/nullableString" },
        "duration_after_grade_11": { "$ref": "#/$defs/nullableString" },
        "gia_form": { "type": "string" },
        "qualification_raw": { "$ref": "#/$defs/nullableString" },
        "comment": { "$ref": "#/$defs/nullableString" }
      },
      "additionalProperties": false
    },
    "role": {
      "type": "object",
      "required": ["canonical_title", "source_basis", "vacancy_queries", "query_confidence", "review_status"],
      "properties": {
        "canonical_title": { "type": "string", "minLength": 1 },
        "source_basis": { "type": "string", "minLength": 1 },
        "vacancy_queries": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "query_confidence": { "enum": ["low", "medium", "curated"] },
        "review_status": { "enum": ["requires_manual_review", "reviewed_for_pilot"] }
      },
      "additionalProperties": false
    },
    "program": {
      "type": "object",
      "required": [
        "program_name", "program_type", "ugps", "is_current", "qualifications",
        "work_roles", "vacancy_queries", "requires_manual_review", "active_standard",
        "all_known_standards"
      ],
      "properties": {
        "program_name": { "type": "string", "minLength": 1 },
        "program_type": { "enum": ["профессия", "специальность"] },
        "ugps": { "type": "string" },
        "is_current": { "type": "boolean" },
        "qualifications": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "work_roles": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/role" } },
        "vacancy_queries": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "requires_manual_review": { "type": "boolean" },
        "active_standard": { "$ref": "#/$defs/standard" },
        "all_known_standards": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/standard" } }
      },
      "additionalProperties": false
    }
  }
}
